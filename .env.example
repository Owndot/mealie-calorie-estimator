# Mealie connection
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=your-dedicated-service-account-token
# How long to wait on a single Mealie API call before giving up.
MEALIE_TIMEOUT_MS=30000

# Per-household API tokens (optional, overrides MEALIE_API_TOKEN)
# Set a token for each household that needs a different account:
# MEALIE_API_TOKEN_<HOUSEHOLD_ID>=your-household-specific-token

# Open Food Facts — the branded/product-food provider. Never queried for generic ingredients.
OFF_LANGUAGE=de
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
# Open Food Facts asks callers to identify themselves. Left empty, the service sends
#   mealie-nutrition-engine/<package version> (+https://github.com/Owndot/mealie-nutrition-engine)
# which stays accurate across upgrades because the version comes from package.json. Set this only
# to identify your own deployment, and keep the same shape — a contact URL, not an email:
#   OFF_USER_AGENT=mealie-nutrition-engine/1.0.0 (+https://github.com/Owndot/mealie-nutrition-engine)
OFF_USER_AGENT=
OFF_MAX_RETRIES=3
OFF_RETRY_BACKOFF_MS=500

# USDA FoodData Central generic foods are BUNDLED and offline (resources/usda/usda-generic.sqlite,
# Foundation 2026-04-30 + SR Legacy 2018-04, public domain/CC0). No API key, no network call: the
# live search API was removed because its result window kept generic records out of reach.
# Set this only to point at a regenerated database; empty uses the bundled one.
USDA_LOCAL_DB_PATH=

# Optional override for the bundled BLS 4.0 database (resources/bls/bls-4.0.sqlite).
BLS_LOCAL_IMPORT_PATH=

# LLM — used for ONE whole-recipe batch normalization request (brand/state/category), plus
# narrowly-scoped per-ingredient fallback: gram estimation for unresolved units, and a final
# per-ingredient nutrient estimate when no provider can resolve the food.
LLM_ENABLED=true
LLM_API_KEY=your-mistral-api-key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=mistral-small-latest
# Your own Mealie recipes as a source for homemade ingredients (a curry paste, a spice mix).
# Exact recipe-name matches only; requires the source recipe to state a yield in grams.
MEALIE_RECIPE_SOURCE_ENABLED=true
MEALIE_RECIPE_INDEX_TTL=300
MEALIE_RECIPE_MAX_DEPTH=1

# Candidate reranking: an LLM judges between DATABASE records retrieval already found.
# Never a source of nutrition; NONE is a valid answer and every failure falls back silently.
LLM_RERANK_ENABLED=true
LLM_RERANK_MAX_CANDIDATES=8
LLM_RERANK_MIN_CONFIDENCE=0.6
LLM_RERANK_TIMEOUT_MS=8000

# Semantic candidate judge. Asked ONLY when the deterministic chain has finished and its answer
# would be a fabricated estimate or nothing at all, while real records survived every hard gate —
# so it can turn an invented number into a real record and cannot make an accepted result worse.
# AMBIGUOUS/NONE/invalid/timeout all leave the existing outcome untouched. Eligibility is SEMANTIC
# (a missing record, an unresolved attribute, a partly-answered identity), never a confidence
# threshold — a comfortable score is not evidence of being right. Set false for the purely
# deterministic chain.
LLM_JUDGE_ENABLED=false
LLM_JUDGE_MODEL=
LLM_JUDGE_MAX_CANDIDATES=12
LLM_JUDGE_TIMEOUT_MS=8000
LLM_JUDGE_MIN_CONFIDENCE=0.6

# User-confirmed food overrides. A person settles an ingredient the automatic chain could not, and
# the decision persists: the override is a POINTER to a real provider record, never a stored
# nutrient value, and a target that cannot be loaded falls back to normal resolution rather than
# serving something stale. Durable user data, so its own file rather than the disposable cache.
OVERRIDES_DB_PATH=data/overrides.db
# Unset means the management API is not registered at all. Set it to enable /overrides.
OVERRIDE_ADMIN_TOKEN=
# Product-by-barcode lookups for OFF-targeted overrides. Shares ONE rate-limit budget, retry policy
# and User-Agent with OFF search — only the host differs.
OFF_PRODUCT_BASE_URL=https://world.openfoodfacts.org
# How long a barcode record fetched for an override stays fresh (seconds), and how long past that
# a cached copy may still answer when OFF is TRANSIENTLY unavailable. A user deliberately chose
# that record; a network blip must not silently return the recipe to the value the override
# exists to replace. Bounded, and never used when OFF authoritatively says the product is gone.
OFF_PRODUCT_TTL=86400
OFF_PRODUCT_STALE_GRACE=604800

LLM_RATE_LIMIT=30

# Estimation strategy
# "all" (default) - estimate every recipe
# "tagged" - only estimate recipes with the tag specified by ESTIMATE_TAG
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate

# Cache TTLs (seconds). Provider matches are cached longest; negative/miss results are retried
# sooner; LLM estimates (least authoritative) are cached shortest.
CACHE_DB_PATH=data/cache.db
CACHE_MATCH_TTL=604800
CACHE_MISS_TTL=86400
CACHE_LLM_TTL=43200

# Server
PORT=8000
LOG_LEVEL=info
