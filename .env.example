# Mealie connection
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=your-dedicated-service-account-token

# Per-household API tokens (optional, overrides MEALIE_API_TOKEN)
# Set a token for each household that needs a different account:
# MEALIE_API_TOKEN_<HOUSEHOLD_ID>=your-household-specific-token

# Open Food Facts — the branded/product-food provider. Never queried for generic ingredients.
OFF_LANGUAGE=de
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_SEARCH_RATE_LIMIT=10
OFF_USER_AGENT=MealieCalorieEstimator/1.0 (your@email.com)
OFF_MAX_RETRIES=3
OFF_RETRY_BACKOFF_MS=500

# USDA FoodData Central generic foods are BUNDLED and offline (resources/usda/usda-generic.sqlite,
# Foundation 2026-04-30 + SR Legacy 2018-04, public domain/CC0). No API key, no network call: the
# live search API was removed because its result window kept generic records out of reach.
# Set this only to point at a regenerated database; empty uses the bundled one.
USDA_LOCAL_DB_PATH=

# Optional override for the bundled BLS 4.0 database (resources/bls/bls-4.0.sqlite).
BLS_LOCAL_IMPORT_PATH=

# LLM — used for ONE whole-recipe batch normalization request (brand/state/category), plus
# narrowly-scoped per-ingredient fallback: gram estimation for unresolved units, and a final
# per-ingredient nutrient estimate when no provider can resolve the food.
LLM_ENABLED=true
LLM_API_KEY=your-mistral-api-key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_ENDPOINT_URL=/chat/completions
LLM_MODEL=mistral-small-latest
# Your own Mealie recipes as a source for homemade ingredients (a curry paste, a spice mix).
# Exact recipe-name matches only; requires the source recipe to state a yield in grams.
MEALIE_RECIPE_SOURCE_ENABLED=true
MEALIE_RECIPE_INDEX_TTL=300
MEALIE_RECIPE_MAX_DEPTH=1

# Candidate reranking: an LLM judges between DATABASE records retrieval already found.
# Never a source of nutrition; NONE is a valid answer and every failure falls back silently.
LLM_RERANK_ENABLED=true
LLM_RERANK_MAX_CANDIDATES=8
LLM_RERANK_MIN_CONFIDENCE=0.6
LLM_RERANK_TIMEOUT_MS=8000

LLM_RATE_LIMIT=30

# Estimation strategy
# "all" (default) - estimate every recipe
# "tagged" - only estimate recipes with the tag specified by ESTIMATE_TAG
ESTIMATE_STRATEGY=all
ESTIMATE_TAG=estimate

# Cache TTLs (seconds). Provider matches are cached longest; negative/miss results are retried
# sooner; LLM estimates (least authoritative) are cached shortest.
CACHE_DB_PATH=data/cache.db
CACHE_MATCH_TTL=604800
CACHE_MISS_TTL=86400
CACHE_LLM_TTL=43200

# Server
PORT=8000
LOG_LEVEL=info
